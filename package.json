{
  "name": "@natebridi/guilloche",
  "version": "0.1.0",
  "description": "Procedural guilloché (rose-engine) patterns as a WebGL2 custom element.",
  "license": "MIT",
  "author": "Nate Bridi",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natebridi/guilloche.git"
  },
  "bugs": "https://github.com/natebridi/guilloche/issues",
  "homepage": "https://github.com/natebridi/guilloche#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "guilloche",
    "rose-engine",
    "webgl2",
    "shader",
    "generative",
    "custom-element",
    "web-component"
  ],
  "sideEffects": [
    "./dist-embed/guilloche-element.js"
  ],
  "types": "./dist-embed/types/index.d.ts",
  "module": "./dist-embed/guilloche.js",
  "exports": {
    ".": {
      "types": "./dist-embed/types/index.d.ts",
      "default": "./dist-embed/guilloche.js"
    },
    "./element": {
      "types": "./dist-embed/types/embed.d.ts",
      "default": "./dist-embed/guilloche-element.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-embed",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embed": "vite build --config vite.config.embed.ts && tsc -p tsconfig.embed.json",
    "build:all": "npm run build && npm run build:embed",
    "preview": "vite preview",
    "thumbs": "node scripts/thumbs.mjs",
    "prepublishOnly": "npm run build:embed"
  },
  "devDependencies": {
    "@jig-ui/react": "^0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "agentation": "^3.0.2",
    "playwright": "^1.62.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.2",
    "vite": "^7.3.6"
  }
}
